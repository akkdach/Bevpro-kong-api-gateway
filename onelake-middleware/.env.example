# ═══════════════════════════════════════════════
# OneLake Middleware — Environment Variables
# ═══════════════════════════════════════════════
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# cp .env.example .env
# ═══════════════════════════════════════════════

# Server
PORT=3005

# Azure OneLake
DB_SERVER=onelake.dfs.fabric.microsoft.com
DB_DATABASE=OneLake

# Azure Service Principal
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# JWT Authentication (ใช้ร่วมกันระหว่าง Middleware กับ Frontend)
JWT_SECRET=your-jwt-secret

# Basic Auth (Request Status API)
BASIC_AUTH_USER=your-basic-user
BASIC_AUTH_PASS=your-basic-pass

# Sync Basic Auth
SYNC_AUTH_USER=your-sync-user
SYNC_AUTH_PASS=your-sync-pass

# QAS SQL Server
QAS_DB_SERVER=your-qas-db-server
QAS_DB_DATABASE=BevproFsQas
QAS_DB_USER=sa
QAS_DB_PASSWORD=your-password
QAS_DB_PORT=1433

# Microsoft Entra ID (Login)
ENTRA_TENANT_ID=your-entra-tenant-id
ENTRA_CLIENT_ID=your-entra-client-id

# Production SQL Server
PROD_DB_SERVER=your-prod-db-server
PROD_DB_DATABASE=BevproFsProd
PROD_DB_USER=sa
PROD_DB_PASSWORD=your-password
PROD_DB_PORT=1433

# Sync Target Database
SYNC_DB_SERVER=your-sync-db-server
SYNC_DB_DATABASE=D365
SYNC_DB_USER=sync_user
SYNC_DB_PASSWORD=your-password
SYNC_DB_PORT=14330
