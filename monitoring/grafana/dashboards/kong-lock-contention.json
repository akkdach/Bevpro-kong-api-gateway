          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  split_part(path, '?', 1) AS \"endpoint\",\n  count(*) FILTER (WHERE latency_ms >= $slow_ms) AS \"ติด lock\",\n  count(*) AS \"เรียกทั้งหมด\",\n  round(100.0 * count(*) FILTER (WHERE latency_ms >= $slow_ms) / NULLIF(count(*), 0), 1) AS \"% ที่ติด\",\n  percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_ms)::int AS \"p95 ms\",\n  max(latency_ms) AS \"สูงสุด ms\"\nFROM kong_api_logs\nWHERE $__timeFilter(request_time)\n  AND path NOT LIKE '/grafana%'\nGROUP BY 1\nHAVING count(*) FILTER (WHERE latency_ms >= $slow_ms) > 0\nORDER BY 2 DESC\nLIMIT 30"
        }
      ]
