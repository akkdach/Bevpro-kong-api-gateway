      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(request_time, '1m'),\n  count(*) FILTER (WHERE latency_ms BETWEEN 29000 AND 33000) AS \"ติด lock 29-33 วินาที\",\n  count(*) FILTER (WHERE latency_ms >= 5000 AND latency_ms < 29000) AS \"ช้า 5-29 วินาที\",\n  count(*) FILTER (WHERE latency_ms < 5000) AS \"ปกติ\"\nFROM kong_api_logs\nWHERE $__timeFilter(request_time)\n  AND service_name = 'bevpro-prod'\nGROUP BY 1\nORDER BY 1"
        }
      ]
